# Required for ethan_sync (local store + multi-device).
POWERSYNC_JWT_SECRET=
SERVER_HOST_LAN=
SERVER_HOST_TAILSCALE=

# Optional LLM category suggestions (must match infra LLM_BUDGETS_SECRET).
